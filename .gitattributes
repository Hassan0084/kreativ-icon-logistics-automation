# Normalize line endings in the repository so Windows and Linux checkouts do not
# produce spurious whole-file diffs. Without this, core.autocrlf rewrites every
# file on each checkout.

* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles and generated migration SQL are LF-only.
*.json text eol=lf
package-lock.json text eol=lf
*.sql text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
