# Application
PORT=5000
NODE_ENV=development

# ─── Supabase Postgres ────────────────────────────────────────────────────────
# Both values come from: Supabase Dashboard → Project Settings → Database
#
# DATABASE_URL -> use the SESSION pooler (port 5432) for Prisma.
#                 IPv4-only networks cannot reach the direct IPv6 endpoint.
#   postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# DIRECT_URL  -> the direct connection, used only for schema migrations.
#   postgresql://USER:PASSWORD@db.REGION.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.REGION.supabase.co:5432/postgres"

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Service role key bypasses RLS. Server-side only — never expose to the frontend.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="supplier-invoices"

# ─── Authentication Security ──────────────────────────────────────────────────
JWT_SECRET="change_me_to_a_long_random_string"
JWT_EXPIRES_IN="24h"

# ─── Email SMTP Notification Credentials (optional) ───────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@kreativicon.com"
SMTP_PASSWORD="your_smtp_app_password"
FROM_EMAIL="Kreativ Icon Logistics <noreply@kreativicon.com>"
